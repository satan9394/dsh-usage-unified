{
  "name": "dsh-usage-unified",
  "version": "0.3.2",
  "description": "Unified DeepSeek Harness usage statistics — machine-wide token accounting across every dsh home, with trends, a custom date range that governs every panel, one model panel (share + four-bucket split + call count), a session ranking with call drill-down, CSV/JSON export and an optional local cost estimate that models DeepSeek's off-peak/peak pricing.",
  "license": "MIT",
  "author": "dsh-usage-unified contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satan9394/dsh-usage-unified.git"
  },
  "homepage": "https://github.com/satan9394/dsh-usage-unified#readme",
  "bugs": {
    "url": "https://github.com/satan9394/dsh-usage-unified/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/*.md",
    "NOTICE",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify:realdata": "node scripts/verify-realdata.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:serve": "node scripts/local-smoke.mjs --serve",
    "report": "node scripts/report.mjs --range all --open",
    "report:30d": "node scripts/report.mjs --range 30d --open",
    "pricing:setup": "node scripts/setup-pricing.mjs",
    "leaderboard:setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-leaderboard.ps1",
    "leaderboard:off": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/disable-leaderboard.ps1",
    "store:watch": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/store-watch.ps1",
    "pr:watch": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pr-watch.ps1"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "usage-statistics",
    "analytics"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
